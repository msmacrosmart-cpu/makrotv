# Painel MakroTV - Variáveis de Ambiente para Vercel e local
# Configure estas variáveis no dashboard da Vercel: Settings → Environment Variables

# Auth do painel administrativo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Segredo JWT para sessão (gere um forte, ex: openssl rand -base64 32)
JWT_SECRET=gere-um-segredo-aleatorio-com-openssl-rand-base64-32-e-cole-aqui

# DNS padrão que será retornado quando não houver servidor vinculado ou sem ?u=
DEFAULT_DNS=http://seu-servidor-xtream.com:8080

# URL base do painel - DOMÍNIO DE PRODUÇÃO
NEXT_PUBLIC_PANEL_URL=https://makrotv.vercel.app

# (Opcional) Se usar Postgres externo (Neon, Supabase) - para persistência real em produção
# Sem DATABASE_URL, o painel usa JSON em /tmp (efêmero, reseta a cada deploy)
# DATABASE_URL=postgresql://user:pass@host:5432/makrotv?sslmode=require
