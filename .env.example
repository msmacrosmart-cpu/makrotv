# Painel MakroTV - Variáveis de Ambiente para Vercel e local

# Auth do painel administrativo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Segredo JWT para sessão (gere um forte, ex: openssl rand -base64 32)
JWT_SECRET=troque-este-segredo-por-um-aleatorio-muito-forte-32chars

# DNS padrão que será retornado quando não houver servidor vinculado ou sem ?u=
DEFAULT_DNS=http://seu-servidor-xtream.com:8080

# URL base do painel (para logs e para patch do APK)
NEXT_PUBLIC_PANEL_URL=https://seu-dominio.vercel.app

# (Opcional) Se usar Postgres externo (Neon, Supabase) - ainda não implementado no JSON file mode,
# mas preparado para migração: defina DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:5432/makrotv?sslmode=require
